#!/bin/sh
# The repository's versioned pre-push hook (audit 2026-11-10, QA-01). Installed by `bun run hooks`, which sets
# core.hooksPath to this directory's absolute path: every worktree of the checkout runs this one file, even one on an
# old branch without it. It keeps Git LFS's own pre-push (the LFS objects uploaded), then runs the CI's fast checks
# on the exact revision being pushed: scripts/pre-push.ts (KERR_SKIP_CHECKS=1 skips them, said aloud).
input=$(cat)
command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path."; exit 2; }
printf '%s\n' "$input" | git lfs pre-push "$@" || exit $?
here=$(cd "$(dirname "$0")/.." && pwd)
printf '%s\n' "$input" | exec bun "$here/scripts/pre-push.ts" "$@"
