# The room server (docs/PLAN-RESEAU.md, server/main.ts) on the dedicated server, behind
# stream.samlepirate.org: Bun alone — the protocol (src/net/) and the server, no dependency; its rooms in
# SQLite on the /data volume. Built by .github/workflows/rooms.yml.
FROM oven/bun:1.3-alpine
WORKDIR /app
COPY server/ server/
COPY src/net/ src/net/
ARG BUILD_SHA=dev
ENV PORT=3001 DATA=/data BUILD_SHA=$BUILD_SHA NODE_ENV=production
VOLUME /data
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://127.0.0.1:3001/health >/dev/null || exit 1
CMD ["bun", "server/main.ts"]
