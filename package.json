{
  "name": "black-hole-gpu",
  "devDependencies": {
    "@types/bun": "latest",
    "@webgpu/types": "^0.1.74",
    "typescript": "^5"
  },
  "private": true,
  "scripts": {
    "dev": "bun --hot server.ts",
    "start": "bun server.ts",
    "build": "bun build ./index.html --outdir dist --minify && bun build ./src/system/plan-worker.ts --outfile dist/plan-worker.js --minify --target browser",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build:pages": "bun scripts/build-pages.ts",
    "gallery": "bun scripts/gallery.ts"
  },
  "type": "module"
}
