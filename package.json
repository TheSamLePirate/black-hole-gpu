{
  "name": "black-hole-gpu",
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "latest",
    "@types/tz-lookup": "^6.1.2",
    "@webgpu/types": "^0.1.74",
    "meshoptimizer": "1.3.0",
    "playwright": "^1.63.0",
    "typescript": "^5",
    "webgpu-utils": "2.1.1",
    "zod": "4.6.7"
  },
  "private": true,
  "scripts": {
    "dev": "bun --hot server.ts",
    "start": "bun server.ts",
    "build": "bun scripts/build-pages.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build:pages": "bun scripts/build-pages.ts",
    "gallery": "bun scripts/gallery.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome ci . && tsc --noEmit && bun scripts/check-wgsl.ts",
    "check:forest": "bun scripts/check-forest.ts",
    "check:push": "bun scripts/pre-push.ts --rev HEAD",
    "hooks": "git config core.hooksPath \"$(git rev-parse --show-toplevel)/.githooks\"",
    "check:size": "bun scripts/check-repo-size.ts --base origin/main",
    "e2e": "bun scripts/e2e.ts",
    "remote": "bun scripts/remote.ts",
    "dashboard": "bun scripts/dashboard/server.ts",
    "build:earth-surface": "bun scripts/build-earth-surface.ts"
  },
  "type": "module",
  "dependencies": {
    "@mapbox/vector-tile": "3.0.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-image": "0.9.0",
    "@xterm/xterm": "6.0.0",
    "pbf": "5.1.2",
    "thinking-orbs": "0.3.1",
    "tz-lookup": "6.1.25",
    "unkernel": "0.2.0-261121-e69adda"
  }
}
