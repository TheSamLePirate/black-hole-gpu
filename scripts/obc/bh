#!/bin/sh
# bh — Universal CLI for the entire Black Hole GPU `__bh` API & all 73 TARS tools (input & output).
# Fast path: runs natively on the browser host via Unkernel HostCommand (/run/kw/bin/bh-host) in ~3 ms
# with ZERO Node.js startup overhead. Falls back to `node /obc/lib/bh-cli.mjs` if unavailable.

if [ "$1" = "tui" ]; then
  shift
  exec /obc/scripts/bh-tui "$@"
fi

if [ -x /run/kw/bin/bh-host ]; then
  exec /run/kw/bin/bh-host "$@"
fi

_N=$(command -v node 2>/dev/null || true)
if [ -z "$_N" ] || case "$_N" in /usr/lib/kw/bin/*) true;; *) false;; esac || head -n 1 "$_N" 2>/dev/null | grep -q '^#!'; then
  echo "Node.js not installed yet. Run: obc-install node (or click +Node / +Py+Node in HUD)" >&2
  exit 1
fi

exec node /obc/lib/bh-cli.mjs "$@"
