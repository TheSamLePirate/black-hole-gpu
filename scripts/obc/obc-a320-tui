#!/bin/sh
# obc-a320-tui — Node.js Real-Time Airbus A320 FCU + Live Captain MCDU Mirror + ECAM Console TUI.
# Keys: [a] AP  [t] A/THR  [i] ILS  [g] Gear  [f] Cycle Flaps  [1-6] MCDU L1-L6  [m] MCDU Menu  [e] Cycle ECAM  [q] Quit
# Usage: obc-a320-tui [--frames N]

if [ ! -x /usr/bin/node ] || head -n 1 /usr/bin/node 2>/dev/null | grep -q '^#!'; then
  echo "Node.js not installed yet. Run: obc-install node (or click +Node in HUD)"
  exit 1
fi

cat > /tmp/.obc-a320-tui.mjs <<'JS'
import { AvionicsBus } from "/obc/lib/obc.mjs";

const args = process.argv.slice(2);
let maxFrames = 0;
const fi = args.indexOf("--frames");
if (fi >= 0 && args[fi + 1]) maxFrames = Math.max(1, Number(args[fi + 1]) || 1);
if (args.includes("--once")) maxFrames = 1;

const bus = new AvionicsBus();
const ECAM_PAGES = ["enginePage", "wheelPage", "fctlPage", "fuelPage", "elecPage", "cruisePage", "obcPage"];
let ecamIdx = 6;
let note = "KEYS: [a] AP [t] ATHR [i] ILS [g] GEAR [f] FLAPS [1-6] L1-L6 [m] MENU [e] ECAM [q] QUIT";
let frameCount = 0;
let running = true;
let timer = null;

function cleanup() {
  if (!running) return;
  running = false;
  if (timer) clearInterval(timer);
  try {
    if (process.stdin.isTTY) process.stdin.setRawMode(false);
    process.stdin.pause();
  } catch {}
  process.stdout.write("\x1b[?25h\x1b[0m\n");
  process.exit(0);
}
process.on("SIGINT", cleanup);
process.on("SIGTERM", cleanup);

if (process.stdin.isTTY && maxFrames === 0) {
  try {
    process.stdin.setRawMode(true);
    process.stdin.resume();
    process.stdin.setEncoding("utf8");
    process.stdin.on("data", (k) => {
      if (k === "q" || k === "Q" || k === "\x03") return cleanup();
      if (k >= "1" && k <= "6") {
        bus.bhMcdu("lsk", { lskSide: "L", lskNum: Number(k) });
        note = `MCDU L${k} PRESSED`;
      } else if (k === "m" || k === "M") {
        bus.bhMcdu("page", { page: "menu" });
        note = "MCDU -> MENU";
      } else if (k === "e" || k === "E") {
        ecamIdx = (ecamIdx + 1) % ECAM_PAGES.length;
        const p = ECAM_PAGES[ecamIdx];
        bus.bhMcdu("ecam", { ecam: p });
        note = `LOWER ECAM -> ${p}`;
      } else if (k === "a" || k === "A") {
        const jm = bus.bhGet("camera.jetModes", 1).result ?? {};
        const next = !(jm.alt !== null || jm.hdg !== null);
        bus.bhTool("jet_autopilot", { ap: next });
        note = `A320 AP1 -> ${next ? "ON" : "OFF"}`;
      } else if (k === "t" || k === "T") {
        const jm = bus.bhGet("camera.jetModes", 1).result ?? {};
        const next = !(jm.spd !== null);
        bus.bhTool("jet_autopilot", { athr: next });
        note = `A320 A/THR -> ${next ? "ON" : "OFF"}`;
      } else if (k === "i" || k === "I") {
        const r = bus.bhTool("approach", { action: "ils" });
        note = `APPR ILS: ${String(r.result ?? "").slice(0, 46)}`;
      } else if (k === "g" || k === "G") {
        const st = bus.read();
        bus.setGear(!(st.systems.gear > 0.5));
        note = `GEAR -> ${!(st.systems.gear > 0.5) ? "DOWN" : "UP"}`;
      } else if (k === "f" || k === "F") {
        const st = bus.read();
        const next = st.systems.flaps < 0.25 ? 0.5 : st.systems.flaps < 0.75 ? 1.0 : 0.0;
        bus.setFlaps(next);
        note = `FLAPS -> CONF ${next === 0 ? "0" : next < 0.75 ? "2" : "FULL"}`;
      }
    });
  } catch {}
}

function render() {
  if (!running) return;
  frameCount++;
  const st = bus.read();
  const mcduRes = bus.bhMcdu("screen");
  const mcduRaw = mcduRes.ok ? mcduRes.result : null;
  const mcdu = mcduRaw
    ? {
        pageId: mcduRaw.pageId,
        title: mcduRaw.title,
        sp: mcduRaw.scratchpad || mcduRaw.message || "",
        rows: (mcduRaw.lines || [])
          .slice(0, 6)
          .map((ln) => (ln.c ? ln.c : `${(ln.l || "").padEnd(13)} ${(ln.r || "").padStart(12)}`)),
      }
    : null;
  const fcu = bus.bhGet("camera.jetModes", 1).result ?? {};
  const spdStr = fcu.spd != null ? `${Math.round(fcu.spd * 1.94384)}kt` : "---";
  const hdgStr = fcu.hdg != null ? `${Math.round((fcu.hdg * 180) / Math.PI)}°` : "---";
  const altStr = fcu.alt != null ? `${Math.round(fcu.alt * 3.28084)}ft` : "-----";

  const lines = [
    "\x1b[?25l\x1b[H\x1b[2J",
    "\x1b[1;38;2;62;200;255m╔══════════════════════════════════════════════════════════════╗\x1b[0m",
    "\x1b[1;38;2;62;200;255m║\x1b[1;37m       OBC-A320-TUI · AIRBUS A320 FCU + LIVE MCDU            \x1b[1;38;2;62;200;255m║\x1b[0m",
    "\x1b[1;38;2;62;200;255m╠══════════════════════════════════════════════════════════════╣\x1b[0m",
    `  FCU   : SPD \x1b[1;33m${spdStr.padEnd(6)}\x1b[0m HDG \x1b[1;33m${hdgStr.padEnd(5)}\x1b[0m ALT \x1b[1;33m${altStr.padEnd(8)}\x1b[0m AP1:${fcu.alt != null || fcu.hdg != null ? "\x1b[1;32mON \x1b[0m" : "OFF"} A/THR:${fcu.spd != null ? "\x1b[1;32mON \x1b[0m" : "OFF"}`,
    `  LIVE  : IAS ${(st.flight.true_airspeed_mps * 1.94384).toFixed(0).padStart(3)}kt  M${st.flight.mach.toFixed(2)}  ALT ${Math.round(st.position.altitude_msl_m * 3.28084).toString().padStart(5)}ft  AGL ${st.position.height_over_ground_m.toFixed(0)}m  GEAR ${st.systems.gear > 0.5 ? "DN" : "UP"}  FLAP ${(st.systems.flaps * 100).toFixed(0)}%`,
    "\x1b[38;2;62;200;255m╠──────────────────────────────┬───────────────────────────────╣\x1b[0m",
  ];
  const rw = st.nav?.runway;
  const rightCol = [
    `ECAM SD : ${ECAM_PAGES[ecamIdx]}`,
    `FUEL    : ${(st.systems.fuel_frac * 100).toFixed(1)}%`,
    `THR     : ${(st.systems.throttle * 100).toFixed(0)}%`,
    rw ? `ILS RWY : ${rw.ident} (${(rw.dist_m / 1852).toFixed(1)} NM)` : "ILS RWY : STANDBY",
    rw ? `LOC DEV : ${rw.loc_deg >= 0 ? "+" : ""}${rw.loc_deg.toFixed(2)}°` : "LOC DEV : —",
    rw ? `G/S DEV : ${rw.gs_deg >= 0 ? "+" : ""}${rw.gs_deg.toFixed(2)}°` : "G/S DEV : —",
    `VESSEL  : ${st.vessel_id.toUpperCase()}`,
  ];
  const leftCol = mcdu
    ? [`MCDU: ${mcdu.title.slice(0, 22)}`, ...mcdu.rows.map((r) => r.slice(0, 28))]
    : ["MCDU: NOT ACTIVE", "(Run: obc-a320 fly LFPB)", "", "", "", "", ""];

  for (let i = 0; i < 7; i++) {
    const l = (leftCol[i] ?? "").slice(0, 28).padEnd(28);
    const r = (rightCol[i] ?? "").slice(0, 29).padEnd(29);
    lines.push(`\x1b[1;38;2;62;200;255m║\x1b[1;32m ${l} \x1b[38;2;62;200;255m│\x1b[0m ${r} \x1b[1;38;2;62;200;255m║\x1b[0m`);
  }
  lines.push("\x1b[1;38;2;62;200;255m╚══════════════════════════════╩═══════════════════════════════╝\x1b[0m");
  lines.push(`  \x1b[1;33m${note.slice(0, 62)}\x1b[0m`);
  process.stdout.write(lines.join("\r\n"));

  if (maxFrames > 0 && frameCount >= maxFrames) cleanup();
}

render();
if (running) timer = setInterval(render, 350);
JS
exec node /tmp/.obc-a320-tui.mjs "$@"
