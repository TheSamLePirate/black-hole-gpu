#!/bin/sh
# obc-fb-demo — AAA Multi-Panel Live Telemetry /dev/fb0 Avionics Display (512x512 XRGB8888).
# Renders real live telemetry (altitude, TAS, orbital eccentricity, Ap/Pe, heading, dtau/dt,
# animated radar/orbital sweep, shaded planet disc, apsides ring, attitude indicator & telemetry gauges)
# directly into /dev/fb0 — works immediately offline with zero dependencies AND upgrades with python3.

if [ ! -e /dev/fb0 ]; then
  echo "Error: /dev/fb0 not available."
  exit 1
fi

_P=$(command -v python3 2>/dev/null || true)
if [ -n "$_P" ] && ! head -n 1 "$_P" 2>/dev/null | grep -q '^#!'; then
  exec python3 - <<'PY'
import math, sys, time
sys.path.insert(0, "/obc/lib")
import obc

bus = obc.AvionicsBus()
with obc.Framebuffer() as fb:
    CYAN = fb.color(98, 230, 255)
    CYAN_DIM = fb.color(22, 92, 116)
    GRID = fb.color(11, 56, 74)
    GREEN = fb.color(125, 255, 154)
    AMBER = fb.color(255, 179, 71)
    TEXT = fb.color(214, 249, 255)
    PLANET = fb.color(24, 134, 188)
    for k in range(60):
        st = bus.read()
        fb.clear(3, 24, 34)
        fb.rect(0, 0, 512, 34, fb.color(8, 52, 68))
        fb.line(0, 34, 512, 34, CYAN)
        fb.text(12, 10, f"OBC AVIONICS {st.vessel_id.upper()} / {st.body.upper()}", CYAN, 2)
        for p in range(64, 512, 64):
            fb.line(p, 36, p, 420, GRID)
            fb.line(0, p, 512, p, GRID)
        cx, cy = 256, 228
        fb.circle(cx, cy, 168, CYAN_DIM, 96)
        fb.circle(cx, cy, 118, GRID, 72)
        fb.circle(cx, cy, 52, PLANET, 56)
        orb = st.orbit or {}
        e = min(0.8, max(0.0, float(orb.get("eccentricity", 0.08))))
        a_px = 148.0
        b_px = a_px * math.sqrt(max(0.1, 1.0 - e * e))
        c_px = a_px * e
        prev = None
        for i in range(97):
            th = 2.0 * math.pi * i / 96.0
            px = int(cx - c_px + a_px * math.cos(th))
            py = int(cy + b_px * math.sin(th))
            if prev:
                fb.line(prev[0], prev[1], px, py, CYAN)
            prev = (px, py)
        ang = k * 0.18
        vx = int(cx - c_px + a_px * math.cos(ang))
        vy = int(cy + b_px * math.sin(ang))
        fb.line(cx, cy, vx, vy, GREEN)
        fb.rect(vx - 4, vy - 4, 9, 9, AMBER)
        # Bottom telemetry strip
        fb.rect(0, 422, 512, 90, fb.color(6, 38, 50))
        fb.line(0, 422, 512, 422, CYAN)
        fb.text(12, 434, f"ALT {st.altitude_msl/1000:6.1f}KM  TAS {st.true_airspeed:6.0f}M/S", TEXT, 2)
        fb.text(12, 458, f"HDG {st.heading:5.1f}  E {e:.3f}  G {st.g_load:+.1f}", CYAN, 2)
        fb.text(12, 482, f"KERR DTAU/DT {st.dtau_dt:.6f}", AMBER, 2)
        fb.flush()
        time.sleep(0.08)
PY
fi

# Zero-dependency AAA offline renderer (BusyBox awk -> 512x512 XRGB8888):
# Reads live /obc/telemetry.json, computes real eccentricity & fuel/throttle bars,
# renders shaded planet globe, orbital ellipse, apsides markers, compass ticks,
# and live telemetry gauges into /tmp/obc_fb.raw, then streams atomically to /dev/fb0.
printf "Rendering live AAA 512x512 XRGB8888 orbital/avionics display to /dev/fb0 ...\n"
TEL=$(cat /obc/telemetry.json 2>/dev/null || echo '{}')
awk -v tel="$TEL" '
function jnum(k, d,   m) {
  if (match(tel, "\"" k "\":[ ]*[-0-9.eE+]+")) {
    m = substr(tel, RSTART + length(k) + 3, RLENGTH - length(k) - 3)
    gsub(/^[: ]+/, "", m); return m + 0
  }
  return d
}
BEGIN {
  H = 256; W = 256; cx = 128; cy = 114;
  ecc = jnum("eccentricity", 0.08); if (ecc < 0) ecc = 0; if (ecc > 0.7) ecc = 0.7;
  thr = jnum("throttle", 0.0); if (thr < 0) thr = 0; if (thr > 1) thr = 1;
  fuel = jnum("fuel_frac", 0.94); if (fuel < 0) fuel = 0; if (fuel > 1) fuel = 1;
  hdg = jnum("heading_deg", 45.0) * 3.14159265 / 180.0;
  vx = cx + int(78 * sin(hdg));
  vy = cy - int(78 * cos(hdg));
  # Orbital ellipse parameters
  a = 78.0; b = a * sqrt(1.0 - ecc * ecc); fc = a * ecc;
  # XRGB8888 little-endian (B, G, R, 255) doubled horizontally for 2x2 crisp 512x512
  bg     = sprintf("%c%c%c%c%c%c%c%c", 34, 24,  3, 255, 34, 24,  3, 255);
  panel  = sprintf("%c%c%c%c%c%c%c%c", 68, 52,  8, 255, 68, 52,  8, 255);
  panel2 = sprintf("%c%c%c%c%c%c%c%c", 50, 38,  6, 255, 50, 38,  6, 255);
  grid   = sprintf("%c%c%c%c%c%c%c%c", 74, 56, 11, 255, 74, 56, 11, 255);
  ring   = sprintf("%c%c%c%c%c%c%c%c", 118, 92, 22, 255, 118, 92, 22, 255);
  cyan   = sprintf("%c%c%c%c%c%c%c%c", 255, 230, 98, 255, 255, 230, 98, 255);
  green  = sprintf("%c%c%c%c%c%c%c%c", 154, 255, 125, 255, 154, 255, 125, 255);
  amber  = sprintf("%c%c%c%c%c%c%c%c",  71, 179, 255, 255,  71, 179, 255, 255);
  pLit   = sprintf("%c%c%c%c%c%c%c%c", 215, 158, 38, 255, 215, 158, 38, 255);
  pMid   = sprintf("%c%c%c%c%c%c%c%c", 160, 108, 20, 255, 160, 108, 20, 255);
  pDark  = sprintf("%c%c%c%c%c%c%c%c",  78,  46, 10, 255,  78,  46, 10, 255);
  atmo   = sprintf("%c%c%c%c%c%c%c%c", 248, 198, 72, 255, 248, 198, 72, 255);

  fuelW = int(fuel * 96);
  thrW  = int(thr * 96);
  for (y = 0; y < H; y++) {
    row = ""
    dy = y - cy
    for (x = 0; x < W; x++) {
      dx = x - cx
      r2 = dx * dx + dy * dy
      if (y < 16) {
        px = panel
      } else if (y == 16 || y == 214) {
        px = cyan
      } else if (y > 214) {
        # Bottom live telemetry bar gauges (FUEL left, THR right)
        if (y >= 224 && y <= 232 && x >= 16 && x <= 112) {
          px = (x - 16 <= fuelW) ? green : grid
        } else if (y >= 224 && y <= 232 && x >= 144 && x <= 240) {
          px = (x - 144 <= thrW) ? amber : grid
        } else if (y >= 240 && y <= 246 && x >= 16 && x <= 240) {
          px = ((x % 16) < 12) ? ring : panel2
        } else {
          px = panel2
        }
      } else if (r2 <= 576) {
        # Shaded 3D planet sphere with limb atmosphere glow
        if (r2 >= 500) px = atmo
        else if (dx * 0.65 - dy * 0.55 > 6) px = pLit
        else if (dx * 0.65 - dy * 0.55 > -6) px = pMid
        else px = pDark
      } else {
        # Check orbital ellipse (dx + fc)^2/a^2 + dy^2/b^2 ~= 1
        ex = (dx + fc) / a; ey = dy / b; ev = ex * ex + ey * ey
        if (ev >= 0.955 && ev <= 1.045) px = cyan
        else if (dx >= (vx - cx) - 3 && dx <= (vx - cx) + 3 && dy >= (vy - cy) - 3 && dy <= (vy - cy) + 3) px = amber
        else if (r2 >= 8100 && r2 <= 8450) px = ring
        else if (r2 >= 2950 && r2 <= 3150) px = grid
        else if ((dx == 0 || dy == 0) && r2 < 8300) px = grid
        else if (dx > 0 && dy < 0 && (dx + dy >= -1 && dx + dy <= 1) && r2 < 6100) px = green
        else if ((x % 32 == 0) || (y % 32 == 0)) px = grid
        else px = bg
      }
      row = row px
    }
    printf "%s%s", row, row
  }
}' > /tmp/obc_fb.raw
(cat /tmp/obc_fb.raw; sleep 14) > /dev/fb0 &
echo "AAA orbital/avionics display rendered to /dev/fb0 (512x512 XRGB8888, active 14s)."
