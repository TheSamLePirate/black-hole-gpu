#!/bin/sh
# obc-install — Fast 1-click installer for Python 3 & Node.js via apk + Wisp.
# Installed packages persist in IndexedDB (/data overlay).
# Usage: obc-install [python|node|full|dev]

TARGET="${1:-full}"
echo "OBC Package Manager — installing profile: $TARGET ..."

case "$TARGET" in
  python)
    apk add --no-cache python3
    ;;
  node)
    apk add --no-cache nodejs
    ;;
  full)
    apk add --no-cache python3 nodejs
    ;;
  dev)
    apk add --no-cache python3 py3-pip nodejs npm curl git
    ;;
  *)
    echo "Usage: obc-install [python|node|full|dev]"
    exit 1
    ;;
esac

echo "Done! Python: $(python3 --version 2>/dev/null || echo none) | Node: $(node --version 2>/dev/null || echo none)"
