#!/bin/sh
# obc-nav — Node.js CLI: WGS84 Great-Circle Bearing/Distance/ETA & Hohmann Transfer Calculator.
# Usage: obc-nav [paris|lebourget|nice|edwards|ksfo|ksc|toulon|<lat> <lon>] [--json]

if [ ! -x /usr/bin/node ] || head -n 1 /usr/bin/node 2>/dev/null | grep -q '^#!'; then
  echo "Node.js not installed yet. Run: obc-install node (or click +Node in HUD)"
  exit 1
fi

exec node --input-type=module - "$@" <<'JS'
import { AvionicsBus, wgs84BearingDist } from "/obc/lib/obc.mjs";

const WAYPOINTS = {
  paris: { name: "Paris CDG (LFPG)", lat: 49.0097, lon: 2.5479 },
  lfpg: { name: "Paris CDG (LFPG)", lat: 49.0097, lon: 2.5479 },
  lebourget: { name: "Paris Le Bourget (LFPB)", lat: 48.9694, lon: 2.4414 },
  lfpb: { name: "Paris Le Bourget (LFPB)", lat: 48.9694, lon: 2.4414 },
  nice: { name: "Nice Cote d'Azur (LFMN)", lat: 43.6584, lon: 7.2159 },
  lfmn: { name: "Nice Cote d'Azur (LFMN)", lat: 43.6584, lon: 7.2159 },
  toulon: { name: "Toulon-Hyeres (LFTH)", lat: 43.0973, lon: 6.1460 },
  lfth: { name: "Toulon-Hyeres (LFTH)", lat: 43.0973, lon: 6.1460 },
  edwards: { name: "Edwards AFB (KEDW)", lat: 34.9054, lon: -117.8837 },
  kedw: { name: "Edwards AFB (KEDW)", lat: 34.9054, lon: -117.8837 },
  ksfo: { name: "San Francisco (KSFO)", lat: 37.6213, lon: -122.3790 },
  ksc: { name: "Kennedy Space Center (KTTS)", lat: 28.6150, lon: -80.6945 },
};

const args = process.argv.slice(2);
const asJson = args.includes("--json");
const posArgs = args.filter((a) => !a.startsWith("--"));

const bus = new AvionicsBus();
const st = bus.read();
const lat = st.position.lat_deg;
const lon = st.position.lon_deg;
const gs = Math.max(1, st.flight.ground_speed_mps || st.flight.true_airspeed_mps || 250);

let targets = [];
if (posArgs.length >= 2 && Number.isFinite(Number(posArgs[0])) && Number.isFinite(Number(posArgs[1]))) {
  targets = [{ name: `CUSTOM (${posArgs[0]}, ${posArgs[1]})`, lat: Number(posArgs[0]), lon: Number(posArgs[1]) }];
} else if (posArgs.length === 1) {
  const key = posArgs[0].toLowerCase();
  const wp = WAYPOINTS[key];
  if (!wp) {
    console.error(`Unknown waypoint "${posArgs[0]}". Presets: ${Object.keys(WAYPOINTS).join(", ")}`);
    process.exit(1);
  }
  targets = [wp];
} else {
  targets = [WAYPOINTS.lebourget, WAYPOINTS.nice, WAYPOINTS.toulon, WAYPOINTS.edwards, WAYPOINTS.ksc];
}

const rows = targets.map((t) => {
  const { distM, bearingDeg } = wgs84BearingDist(lat, lon, t.lat, t.lon);
  const etaMin = distM / gs / 60;
  return {
    name: t.name,
    lat: t.lat,
    lon: t.lon,
    dist_km: +(distM / 1000).toFixed(1),
    dist_nm: +(distM / 1852).toFixed(1),
    bearing_deg: +bearingDeg.toFixed(1),
    eta_min: +etaMin.toFixed(1),
  };
});

if (asJson) {
  console.log(JSON.stringify({ vessel: st.vessel_id, body: st.body, origin: { lat, lon }, gs_mps: +gs.toFixed(1), legs: rows }, null, 2));
  process.exit(0);
}

console.log("\x1b[1;36m╔══════════════════════════════════════════════════════════════╗\x1b[0m");
console.log("\x1b[1;36m║\x1b[1;37m       OBC-NAV (NODE.JS) · WGS84 GREAT-CIRCLE NAVIGATOR      \x1b[1;36m║\x1b[0m");
console.log("\x1b[1;36m╚══════════════════════════════════════════════════════════════╝\x1b[0m");
console.log(`  POS : ${lat.toFixed(4)}° N, ${lon.toFixed(4)}° E   HDG : ${st.attitude.heading_deg.toFixed(1)}°   GS : ${gs.toFixed(1)} m/s`);
console.log("  ──────────────────────────────────────────────────────────────");
console.log("  DESTINATION                    BRG     DIST (km / NM)     ETA");
for (const r of rows) {
  const nm = r.name.padEnd(28);
  const brg = `${r.bearing_deg.toFixed(1).padStart(5)}°`;
  const dist = `${r.dist_km.toFixed(1).padStart(7)} km / ${r.dist_nm.toFixed(0).padStart(5)} NM`;
  const eta = r.eta_min > 120 ? `${(r.eta_min / 60).toFixed(1)} h` : `${r.eta_min.toFixed(1)} m`;
  console.log(`  ${nm} ${brg}  ${dist}  ${eta.padStart(6)}`);
}
JS
