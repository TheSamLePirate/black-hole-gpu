#!/bin/sh
# obc-reentry — Atmospheric Entry Corridor & Thermal/Energy Monitor.
# Pass `--fb` when Python 3 is installed to render live thermal & corridor gauges on /dev/fb0.

if [ "$1" = "--fb" ] && [ -x /usr/bin/python3 ] && ! head -n 1 /usr/bin/python3 2>/dev/null | grep -q '^#!'; then
  exec python3 - <<'PY'
import time, obc
bus = obc.AvionicsBus()
with obc.Framebuffer() as fb:
    cyan = fb.color(98, 230, 255)
    dim = fb.color(22, 68, 86)
    bg_bar = fb.color(8, 34, 46)
    ok = fb.color(125, 255, 154)
    amber = fb.color(255, 179, 71)
    red = fb.color(255, 90, 70)
    white = fb.color(235, 250, 255)
    hist_t = []
    for _ in range(120):
        st = bus.read()
        fb.clear(4, 24, 34)
        fb.text(18, 16, "OBC ENTRY THERMAL CORRIDOR", cyan, scale=2)
        fb.rect(20, 48, 472, 1, dim)
        tk = max(250.0, st.hull_temp_k)
        hist_t.append(tk)
        if len(hist_t) > 64:
            hist_t.pop(0)
        q_frac = min(1.0, st.dynamic_pressure / 60000.0)
        t_frac = min(1.0, (tk - 250.0) / 1750.0)
        g_frac = min(1.0, abs(st.g_load) / 6.0)
        fb.text(24, 68, f"ALT {st.altitude_msl/1000:.1f} KM   MACH {st.mach:.2f}", white, scale=2)
        fb.text(24, 114, f"Q-PRESS  {st.dynamic_pressure:.0f} PA", cyan, scale=2)
        fb.bar_gauge(24, 138, 464, 26, q_frac, red if q_frac > 0.8 else amber if q_frac > 0.4 else ok, bg_bar, dim)
        fb.text(24, 184, f"HULL TEMP {tk:.0f} K", cyan, scale=2)
        fb.bar_gauge(24, 208, 464, 26, t_frac, red if t_frac > 0.8 else amber if t_frac > 0.4 else ok, bg_bar, dim)
        fb.text(24, 254, f"LOAD {st.g_load:+.2f} G", cyan, scale=2)
        fb.bar_gauge(24, 278, 464, 26, g_frac, red if g_frac > 0.8 else amber if g_frac > 0.5 else ok, bg_bar, dim)
        fb.text(24, 326, "THERMAL TREND", dim, scale=2)
        fb.sparkline(24, 352, 464, 128, hist_t, amber, bg_bar, dim)
        fb.flush()
        time.sleep(0.15)
PY
fi

printf '\033[2J\033[H'
printf '\033[1;36m╔══════════════════════════════════════════════════════════════╗\033[0m\n'
printf '\033[1;36m║\033[1;37m       OBC ATMOSPHERIC RE-ENTRY & THERMAL CORRIDOR           \033[1;36m║\033[0m\n'
printf '\033[1;36m╚══════════════════════════════════════════════════════════════╝\033[0m\n'

cat /obc/telemetry.json 2>/dev/null | awk '
function val(k,   m) {
  if (match($0, "\"" k "\":[ ]*[-0-9.eE+]+")) {
    m = substr($0, RSTART + length(k) + 3, RLENGTH - length(k) - 3)
    gsub(/^[: ]+/, "", m); return m + 0
  }
  return 0
}
function bar(frac, w,   n, i, s) {
  if (frac < 0) frac = 0; if (frac > 1) frac = 1
  n = int(frac * w + 0.5); s = ""
  for (i = 0; i < w; i++) s = s (i < n ? "█" : "░")
  return s
}
{
  alt = val("altitude_msl_m")
  tas = val("true_airspeed_mps")
  vs = val("vertical_speed_mps")
  mach = val("mach")
  q = val("dynamic_pressure_pa")
  g = val("g_load")
  tk = val("hull_temp_k")
  if (tk < 200) tk = 288
  # Specific mechanical energy per kg relative to sea level
  energy = 9.80665 * alt + 0.5 * tas * tas
  status = "NOMINAL"
  if (tk > 1650 || q > 55000) status = "CRITICAL THERMAL/Q"
  else if (tk > 900 || q > 25000) status = "ENTRY HEATING"
  printf "  ALTITUDE MSL   : %10.1f m  (%.2f km)\n", alt, alt / 1000
  printf "  TRUE AIRSPEED  : %10.1f m/s (Mach %.2f)\n", tas, mach
  printf "  VERTICAL SPEED : %+10.1f m/s\n", vs
  printf "  DYNAMIC PRESS q: %10.0f Pa  [%s]\n", q, bar(q / 60000, 24)
  printf "  HULL TEMP      : %10.0f K   [%s]\n", tk, bar((tk - 250) / 1750, 24)
  printf "  LOAD FACTOR    : %+10.2f g   [%s]\n", g, bar(g / 6, 24)
  printf "  SPECIFIC ENERGY: %10.2f MJ/kg\n", energy / 1e6
  printf "  CORRIDOR STATE : \033[1;33m%s\033[0m\n", status
}' || echo "Telemetry unavailable."
