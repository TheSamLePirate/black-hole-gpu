#!/bin/sh
# obc-top — Node.js Real-Time Interactive Avionics & Systems TUI (htop-style).
# Keys: [q] quit  [s] toggle SAS  [g] toggle Gear  [+/-] throttle ±10%  [0] cut throttle  [p] hold prograde
# Usage: obc-top [--frames N]

_N=$(command -v node 2>/dev/null || true)
if [ -z "$_N" ] || case "$_N" in /usr/lib/kw/bin/*) true;; *) false;; esac || head -n 1 "$_N" 2>/dev/null | grep -q '^#!'; then
  echo "Node.js not installed yet. Run: obc-install node (or click +Node in HUD)"
  exit 1
fi

cat > /tmp/.obc-top.mjs <<'JS'
import { AvionicsBus, ansiBar } from "/obc/lib/obc.mjs";

const args = process.argv.slice(2);
let maxFrames = 0;
const fi = args.indexOf("--frames");
if (fi >= 0 && args[fi + 1]) maxFrames = Math.max(1, Number(args[fi + 1]) || 1);
if (args.includes("--once")) maxFrames = 1;

const bus = new AvionicsBus();
const sparks = "▁▂▃▄▅▆▇█";
const tasHist = [];
const altHist = [];
let lastMsg = "KEYS: [s] SAS  [g] GEAR  [+/-] THR  [0] CUT  [p] PROGRADE  [q] QUIT";
let frameCount = 0;
let running = true;

function sparkline(arr, w = 28) {
  if (arr.length === 0) return " ".repeat(w);
  const slice = arr.slice(-w);
  const lo = Math.min(...slice);
  const hi = Math.max(...slice);
  const span = hi > lo ? hi - lo : 1;
  return slice
    .map((v) => sparks[Math.min(7, Math.max(0, Math.floor(((v - lo) / span) * 7.99)))])
    .join("")
    .padStart(w, " ");
}

function horizonBar(pitchDeg, rollDeg) {
  const idx = Math.max(0, Math.min(20, Math.round(10 + (rollDeg / 45) * 10)));
  let s = "";
  for (let i = 0; i <= 20; i++) s += i === idx ? "◆" : i === 10 ? "┼" : "─";
  return `[${s}] P:${pitchDeg >= 0 ? "+" : ""}${pitchDeg.toFixed(1)}° R:${rollDeg >= 0 ? "+" : ""}${rollDeg.toFixed(1)}°`;
}

if (process.stdin.isTTY && maxFrames === 0) {
  try {
    process.stdin.setRawMode(true);
    process.stdin.resume();
    process.stdin.setEncoding("utf8");
    process.stdin.on("data", (k) => {
      if (k === "q" || k === "Q" || k === "\x03") {
        cleanup();
        return;
      }
      const st = bus.read();
      if (k === "s" || k === "S") {
        bus.setSas(!st.systems.sas);
        lastMsg = `SAS -> ${!st.systems.sas ? "ON" : "OFF"}`;
      } else if (k === "g" || k === "G") {
        bus.setGear(!(st.systems.gear > 0.5));
        lastMsg = `GEAR -> ${!(st.systems.gear > 0.5) ? "DOWN" : "UP"}`;
      } else if (k === "+" || k === "=") {
        const nt = Math.min(1, +(st.systems.throttle + 0.1).toFixed(2));
        bus.setThrottle(nt);
        lastMsg = `THROTTLE -> ${Math.round(nt * 100)}%`;
      } else if (k === "-" || k === "_") {
        const nt = Math.max(0, +(st.systems.throttle - 0.1).toFixed(2));
        bus.setThrottle(nt);
        lastMsg = `THROTTLE -> ${Math.round(nt * 100)}%`;
      } else if (k === "0") {
        bus.setThrottle(0);
        lastMsg = "THROTTLE CUT (0%)";
      } else if (k === "p" || k === "P") {
        bus.setHold("prograde");
        lastMsg = "ATTITUDE HOLD -> PROGRADE";
      }
    });
  } catch {
    // non-interactive tty
  }
}

let timer = null;
function cleanup() {
  if (!running) return;
  running = false;
  if (timer) clearInterval(timer);
  try {
    if (process.stdin.isTTY) process.stdin.setRawMode(false);
    process.stdin.pause();
  } catch {}
  process.stdout.write("\x1b[?25h\x1b[0m\n");
  process.exit(0);
}
process.on("SIGINT", cleanup);
process.on("SIGTERM", cleanup);

function render() {
  if (!running) return;
  const st = bus.read();
  frameCount++;
  tasHist.push(st.flight.true_airspeed_mps);
  altHist.push(st.position.altitude_msl_m);
  if (tasHist.length > 64) tasHist.shift();
  if (altHist.length > 64) altHist.shift();

  const thr = st.systems.throttle;
  const fuel = st.systems.fuel_frac;
  const qFrac = Math.min(1, st.flight.dynamic_pressure_pa / 50000);
  const tK = Math.max(250, st.flight.hull_temp_k || 288);
  const tFrac = Math.min(1, (tK - 250) / 1600);
  const gFrac = Math.min(1, Math.abs(st.flight.g_load) / 7);

  const lines = [
    "\x1b[?25l\x1b[H\x1b[2J",
    `\x1b[1;38;2;98;230;255m╔══════════════════════════════════════════════════════════════╗\x1b[0m`,
    `\x1b[1;38;2;98;230;255m║\x1b[1;38;2;235;250;255m OBC-TOP (NODE.JS TUI) · ${st.vessel_id.toUpperCase().padEnd(10)} · ${st.body.toUpperCase().padEnd(10)}  WARP ${String(st.warp).padStart(3)}x \x1b[1;38;2;98;230;255m║\x1b[0m`,
    `\x1b[1;38;2;98;230;255m╠══════════════════════════════════════════════════════════════╣\x1b[0m`,
    `  WGS84 : ${st.position.lat_deg.toFixed(4).padStart(9)}° N   ${st.position.lon_deg.toFixed(4).padStart(10)}° E   HDG ${st.attitude.heading_deg.toFixed(1).padStart(5)}°`,
    `  ALT   : ${(st.position.altitude_msl_m / 1000).toFixed(2).padStart(8)} km MSL   AGL ${st.position.height_over_ground_m.toFixed(0).padStart(7)} m`,
    `  SPEED : ${st.flight.true_airspeed_mps.toFixed(1).padStart(8)} m/s TAS  MACH ${st.flight.mach.toFixed(2).padStart(5)}   V/S ${(st.flight.vertical_speed_mps >= 0 ? "+" : "") + st.flight.vertical_speed_mps.toFixed(1).padStart(6)} m/s`,
    `  ATT   : ${horizonBar(st.attitude.pitch_deg, st.attitude.roll_deg)}`,
    `\x1b[38;2;60;159;182m  ──────────────────────────────────────────────────────────────\x1b[0m`,
    `  THR  [${ansiBar(thr, 22, "255;179;71")}] ${(thr * 100).toFixed(0).padStart(3)}%   SAS:${st.systems.sas ? "\x1b[1;32mON \x1b[0m" : "\x1b[2mOFF\x1b[0m"}  GEAR:${st.systems.gear > 0.5 ? "\x1b[1;32mDN\x1b[0m" : "\x1b[2mUP\x1b[0m"}`,
    `  FUEL [${ansiBar(fuel, 22, fuel < 0.15 ? "255;90;70" : "125;255;154")}] ${(fuel * 100).toFixed(1).padStart(5)}% AP:${String(st.systems.autopilot).slice(0, 8).padEnd(8)}`,
    `  Q-PA [${ansiBar(qFrac, 22, "98;230;255")}] ${st.flight.dynamic_pressure_pa.toFixed(0).padStart(6)} Pa  HOLD:${String(st.systems.hold).slice(0, 8)}`,
    `  TEMP [${ansiBar(tFrac, 22, tK > 1000 ? "255;90;70" : "255;179;71")}] ${tK.toFixed(0).padStart(5)} K   G:${st.flight.g_load.toFixed(2).padStart(5)}g`,
    `  LOAD [${ansiBar(gFrac, 22, "125;255;154")}] dτ/dt=${st.dtau_dt.toFixed(8)}`,
    `\x1b[38;2;60;159;182m  ──────────────────────────────────────────────────────────────\x1b[0m`,
    `  TAS TREND [\x1b[38;2;98;230;255m${sparkline(tasHist, 24)}\x1b[0m]  ALT [\x1b[38;2;125;255;154m${sparkline(altHist, 16)}\x1b[0m]`,
    `\x1b[1;38;2;98;230;255m╚══════════════════════════════════════════════════════════════╝\x1b[0m`,
    `  \x1b[38;2;255;179;71m${lastMsg}\x1b[0m`,
  ];
  process.stdout.write(lines.join("\r\n"));

  if (maxFrames > 0 && frameCount >= maxFrames) {
    cleanup();
  }
}

render();
if (running) timer = setInterval(render, 200);
JS
exec node /tmp/.obc-top.mjs "$@"
