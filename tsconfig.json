{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "types": ["bun", "@webgpu/types"],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true
  },
  "include": [
    "src",
    "tests",
    "server.ts",
    "server",
    "scripts/dashboard",
    "scripts/e2e.ts",
    "scripts/bh-api.ts",
    "scripts/build-pages.ts",
    "scripts/build-scenery-worker.ts",
    "scripts/check-wgsl.ts",
    "scripts/check-repo-size.ts",
    "scripts/pre-push.ts",
    "scripts/pipeline-inventory.ts",
    "scripts/e2e-catalogue.ts",
    "scripts/remote.ts",
    "scripts/site-smoke.ts",
    "scripts/nightly-bench.ts",
    "scripts/e2e-waits.ts",
    "scripts/build-approaches.ts",
    "scripts/lib"
  ],
  "exclude": ["tests/e2e/zz-*"]
}
